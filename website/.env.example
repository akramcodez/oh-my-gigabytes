# Public: the Dodo Payments product ID for a sponsor slot (pdt_...). Without it the slots link to X.
NEXT_PUBLIC_DODO_SPONSOR_PRODUCT=
# Optional: https://test.checkout.dodopayments.com while testing with a test-mode product.
NEXT_PUBLIC_DODO_CHECKOUT_URL=

# Server only, never NEXT_PUBLIC_: used by /api/dodo-webhook to email you when a sponsor pays.
DODO_WEBHOOK_SECRET=
RESEND_API_KEY=
# Optional overrides for the notification email.
SPONSOR_MAIL_TO=
SPONSOR_MAIL_FROM=
